<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/light_blue">

    <!-- 1. ImageButton w lewym górnym rogu -->
    <ImageButton
        android:id="@+id/helpButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/rounded_button"
        android:src="@drawable/question"
        android:contentDescription="Menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 2. ImageButton z tekstem na środku, pod pkt. 1 -->
    <FrameLayout
        android:id="@+id/buttonContainer1"
        android:layout_width="350dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@+id/helpButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp">

        <ImageButton
            android:id="@+id/buttonRozpoznaj"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rect_rounded"
            android:scaleType="fitXY"
            android:padding="0dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Rozpoznaj głos"
            android:textColor="@color/brown"
            android:textSize="30sp"
            android:gravity="center"
            android:fontFamily="@font/font_family"/>
    </FrameLayout>

    <!-- 3. ImageButton z tekstem pod pkt. 2 -->
    <FrameLayout
        android:id="@+id/buttonContainer2"
        android:layout_width="350dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/buttonContainer1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/buttonLimit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rect_rounded"
            android:scaleType="fitXY"
            android:padding="0dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Limit słów"
            android:textColor="@color/brown"
            android:textSize="30sp"
            android:gravity="center"
            android:fontFamily="@font/font_family"/>
    </FrameLayout>

    <!-- 4. TextView pod 3 -->
    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Liczba słów:"
        app:layout_constraintTop_toBottomOf="@id/buttonContainer2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:textColor="@color/brown"
        android:fontFamily="@font/font_family"
        android:textSize="30sp"/>

    <!-- 5. TextView pod 4 -->
    <TextView
        android:id="@+id/displayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:textColor="@color/brown"
        android:fontFamily="@font/font_family"
        android:textSize="30sp"/>

    <!-- 6. TextView pod 5 -->
    <TextView
        android:id="@+id/text3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pozostało:"
        app:layout_constraintTop_toBottomOf="@id/displayText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:textColor="@color/brown"
        android:fontFamily="@font/font_family"
        android:textSize="30sp"/>

    <!-- 7. TextView pod 6 -->
    <TextView
        android:id="@+id/displaynumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:textColor="@color/brown"
        android:fontFamily="@font/font_family"
        android:textSize="30sp"/>

    <!-- 2. ImageButton z Testem -->
    <FrameLayout
        android:id="@+id/buttonContainer5"
        android:layout_width="250dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@+id/displaynumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp">

        <ImageButton
            android:id="@+id/buttonTest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rect_rounded"
            android:scaleType="fitXY"
            android:padding="0dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Test serwera"
            android:textColor="@color/brown"
            android:textSize="30sp"
            android:gravity="center"
            android:fontFamily="@font/font_family"/>
    </FrameLayout>


    <!-- 8. ImageButton bez tekstu w prawym dolnym rogu -->
    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/rounded_button"
        android:src="@drawable/baseline_settings_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

