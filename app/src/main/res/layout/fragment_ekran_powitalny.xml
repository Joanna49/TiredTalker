<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue">

    <ImageView
        android:id="@+id/circleIcon"
        android:layout_width="277dp"
        android:layout_height="280dp"
        android:contentDescription="@string/blue_circle_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/blue_circle"
        app2:layout_constraintEnd_toEndOf="parent"
        app2:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/welcomeText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        tools:layout_editor_absoluteY="105dp" />

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tired"
        android:textColor="@color/brown"
        android:textSize="40sp"
        app2:layout_constraintBottom_toBottomOf="@+id/circleIcon"
        app2:layout_constraintEnd_toEndOf="@+id/circleIcon"
        app2:layout_constraintStart_toStartOf="@+id/circleIcon"
        app2:layout_constraintTop_toTopOf="@+id/circleIcon"
        app2:layout_constraintVertical_bias="0.405"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.1" />

    <TextView
        android:id="@+id/welcomeText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Talker"
        android:textColor="@color/brown"
        android:textSize="40sp"
        app2:layout_constraintEnd_toEndOf="@+id/circleIcon"
        app2:layout_constraintStart_toStartOf="@+id/circleIcon"
        app2:layout_constraintTop_toBottomOf="@+id/welcomeText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.1" />


</androidx.constraintlayout.widget.ConstraintLayout>